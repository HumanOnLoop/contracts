{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/osbe/contracts/events/run/MainBroken.schema.json",
  "title": "MainBroken",
  "description": "Main went red after a merge. Topic hotl.run; subject and key: the run id. Producer: CI/CD adapter. Main consumers: Orchestrator (fix or revert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repo": {
      "$ref": "../common.schema.json#/definitions/Repo"
    },
    "commit": {
      "$ref": "../common.schema.json#/definitions/Commit"
    },
    "pipeline": {
      "$ref": "../common.schema.json#/definitions/Url"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short summary of what failed."
    }
  },
  "required": [
    "repo",
    "commit"
  ]
}
