{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/osbe/contracts/events/run/TaskFailed.schema.json",
  "title": "TaskFailed",
  "description": "A task exhausted its retries. Topic hotl.run; subject and key: the run id. Producer: Orchestrator. Main consumers: Review service (budget brief).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "../common.schema.json#/definitions/TaskId"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "description": "Attempts made."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Why the last attempt failed."
    }
  },
  "required": [
    "taskId",
    "attempts",
    "reason"
  ]
}
